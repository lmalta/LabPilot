# Configuration d'Ollama
OLLAMA_URL=http://<ADRESSE_OLLAMA>:11434
OLLAMA_MODEL=qwen3:8b

# Configuration de Home Assistant
# URL HTTP de l'instance Home Assistant
HOME_ASSISTANT_URL=http://<ADRESSE_HOME_ASSISTANT>:8123

# Jeton d'accès longue durée Home Assistant
# Remplacer cette valeur dans le fichier .env local uniquement.
# Ne jamais inscrire le véritable jeton dans ce fichier.
HOME_ASSISTANT_TOKEN=<VOTRE_JETON>
